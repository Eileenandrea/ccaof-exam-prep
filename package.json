{
  "name": "ccaof-exam-prep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CCAO-F exam prep app server (local Express API + SQLite)",
  "scripts": {
    "server": "tsx watch server/index.ts",
    "migrate": "tsx server/db/migrate.ts",
    "seed": "tsx server/db/seed.ts",
    "generate": "tsx server/generator/generateQuestions.ts",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "@supabase/supabase-js": "^2.29.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/uuid": "^9.0.8",
    "concurrently": "^8.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
